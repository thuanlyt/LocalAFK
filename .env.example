# Required — Bot 1, the Controller. Owns slash-command registration, /afk status, /afk stats,
# and authorization for every command. Discord Developer Portal > Application > Bot > Reset Token.
BOT_TOKEN=

# Optional — Bots 2-5, Workers. Each is a separate official Discord bot account/application
# with its own token. Leave a slot empty to leave it unconfigured; the Controller starts fine
# with zero, some, or all four configured. Do not rename these keys.
TOKEN_2=
TOKEN_3=
TOKEN_4=
TOKEN_5=

# Comma-separated Discord user IDs authorized to run /afk commands (all five bots' control
# goes through the Controller's slash commands).
OWNER_DISCORD_IDS=

# Optional: register commands in one guild instead of globally.
# Leave empty for global command registration.
COMMAND_GUILD_ID=

# Optional: directory for persistent state. The Controller uses state.json; each configured
# worker slot gets its own state.bot<N>.json (desiredVoice + enabled), isolated from the others.
DATA_DIR=./data

# Optional: set to true to include the OS hostname in /afk stats.
# Defaults to omitted, since a self-chosen hostname can be identifying/private.
STATS_SHOW_HOSTNAME=false
