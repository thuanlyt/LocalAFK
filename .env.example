# Required
# Discord Developer Portal > Application > Bot > Reset Token
BOT_TOKEN=

# Comma-separated Discord user IDs authorized to run /afk commands
OWNER_DISCORD_IDS=

# Optional: register commands in one guild instead of globally.
# Leave empty for global command registration.
COMMAND_GUILD_ID=

# Optional: directory for persistent state.json.
DATA_DIR=./data

# Optional: set to true to include the OS hostname in /afk stats.
# Defaults to omitted, since a self-chosen hostname can be identifying/private.
STATS_SHOW_HOSTNAME=false
