# === Discord Bot (required) ===
# Discord Developer Portal > your Application > Bot tab > Reset Token
BOT_TOKEN=

# === Discord OAuth2 login (optional — enables the "Login with Discord" button) ===
# Same Application > OAuth2 tab
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Comma-separated Discord user IDs allowed to log in via OAuth (leave empty = OAuth login disabled)
OWNER_DISCORD_IDS=

# === Simple password login (optional — alternative/fallback to OAuth) ===
DASHBOARD_PASSWORD=

# === Session ===
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to true only when served over HTTPS (e.g. behind a reverse proxy)
COOKIE_SECURE=false

# === Server ===
PORT=3000
# Bind address. Keep 127.0.0.1 for native/systemd deployments behind a reverse proxy.
# docker-compose.yml overrides this to 0.0.0.0 automatically inside the container.
HOST=127.0.0.1
# Directory for runtime state (state.json). Defaults to ./data next to the source tree;
# set to an absolute path (e.g. /var/lib/localafk) to keep state outside a release directory.
DATA_DIR=
